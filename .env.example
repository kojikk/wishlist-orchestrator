# Порт внутри контейнера
PORT=3000

# Интервал опроса инстансов (секунды)
REFRESH_INTERVAL_SEC=120

# Таймаут одного запроса к инстансу (мс)
REQUEST_TIMEOUT_MS=10000

# NODE_ENV: development | production
NODE_ENV=production

# ── Caddy auto-sync ──────────────────────────────────────────────────────
# Адрес admin-API Caddy. Если задан — оркестратор автоматически генерирует
# Caddyfile из instances.json и пушит туда при каждом изменении.
# Внутри docker-сети wishnet — http://caddy:2019. Снаружи — обычно НЕ задан.
CADDY_ADMIN_URL=http://caddy:2019

# Email для Let's Encrypt (только если НЕ используешь Cloudflare orange cloud).
# Если Cloudflare проксирует запросы — оставь пустым: Caddy включит auto_https off
# и будет работать как HTTP-прокси (SSL терминирует Cloudflare).
CADDY_ACME_EMAIL=

# ── Admin UI ─────────────────────────────────────────────────────────────
# Токен для доступа к /admin (CRUD над instances.json через UI).
# Если НЕ задан — админка выключена и страница /admin отдаёт «отключено».
# Сгенерировать можно так: `openssl rand -hex 32`
ADMIN_TOKEN=

# ── Публичные URL ────────────────────────────────────────────────────────
# HTTPS-порт, по которому вишлисты доступны снаружи. Если хостовый :443
# свободен и Caddy проброшен как 443:443 — оставь 443 (порт в URL не пишется).
PUBLIC_HTTPS_PORT=443

# Внешний IP сервера — используется DNS-проверкой поддоменов в админке.
PUBLIC_IP=

# ── Docker (lifecycle/провижининг) ───────────────────────────────────────
# Сеть, в которой живут вишлисты и создаются новые контейнеры.
WISHLIST_NETWORK=wishnet

# Контейнеры, которые админка не может останавливать/удалять/пересоздавать.
PROTECTED_CONTAINERS=caddy,wishlist-orchestrator
