# Этот файл — БУТСТРАП. Реальный набор поддоменов после старта подменяет
# wishlist-orchestrator через Admin API (POST http://caddy:2019/load).
#
# Что есть здесь:
#   - global block с admin API внутри wishnet
#   - заглушка для дефолтного хоста, чтобы Caddy не падал
# ═══════════════════════════════════════════════════════════════════════════

{
	# Admin API доступен ТОЛЬКО изнутри docker-сети (на адресе контейнера).
	# Снаружи порт 2019 не публикуется — см. docker-compose.yml.
	admin 0.0.0.0:2019

	# email для ACME (Let's Encrypt уведомления). Подставьте свой через
	# переменную CADDY_ACME_EMAIL в .env оркестратора — она будет вписана
	# сюда автоматически при ребилде Caddyfile из оркестратора.
	email kojikk.228@gmail.com
}

# Заглушка — отвечает 200, если кто-то ткнётся по IP без правильного Host.
# После загрузки конфига от оркестратора этот блок заменится списком инстансов.
:80, :443 {
	respond "Wishlist proxy ready. Configure via orchestrator." 200
}
